DATABASE_URL=postgresql+asyncpg://covey:covey@localhost:5434/covey_keep_dev
# Optional, comma-separated; defaults to the Vite dev server when unset.
# ALLOWED_ORIGINS=http://localhost:5173

# Session-JWT signing key. Required, no default (a signing key with a fallback
# is worse than a crash). Generate one per environment; never reuse:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-me-see-comment-above

# Link bases: the frontend origin and this API's own public origin
# (magic links are minted against API_BASE_URL).
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000

# WebAuthn Relying Party (CK-10): the bare domain passkeys are bound to, and
# the full frontend origin. A passkey does NOT survive a domain change — see
# the RP-ID gotcha in the docs-root CLAUDE.md before touching these.
# Defaults (unset) cover local dev: localhost / http://localhost:5173.
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGIN=http://localhost:5173

# Email delivery: "console" (default) prints the full message to the logs.
# Provider mode + its credentials belong to the cutover phase; leave unset.
EMAIL_MODE=console
# EMAIL_API_KEY=
# EMAIL_FROM=
